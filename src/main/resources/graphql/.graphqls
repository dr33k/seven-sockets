type Subscription{
    newMsgs:[Msg!]
    presenceStatusStream(acctId: ID!):[PresenceStatus!]
}

type Query{
    readMsg(id: ID!):Msg
}

type Mutation{
    heartbeat: Boolean,
    sendMsg(content: String, to: String!, object: [String]!): Msg
}

type Acct{
    id: ID!
    firstName: String!
    lastName: String!
    phoneNo: String!
    email: String!
}

type PresenceStatus{
    lastSeen: String!
}

type Msg{
    id: ID!
    content: String!
    objects: [String]!
    from: Acct!
    to: Acct!
    sentTms: String!
    deliveryTms: String
    receiptTms: String
}